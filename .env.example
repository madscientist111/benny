# Copy to .env. Read by vite.config.ts, cloudflare.config.ts and scripts/test-webhook.mjs.

# Hosts allowed to reach the dev server through a tunnel, comma-separated.
DEV_ALLOWED_HOSTS=

# Where Claude Code's containers reach this Worker's `/mcp` (cloudflare.config.ts): the deployed
# Worker's URL, and the tunnel to the dev server. Needed only in the modes that run Claude Code.
PUBLIC_BASE_URL_PRODUCTION=
PUBLIC_BASE_URL_DEV=

# For `pnpm webhook:test`: the GitHub App's webhook secret and the installation the test replies through.
GITHUB_WEBHOOK_SECRET=
GITHUB_INSTALLATION_ID=
