# Copy to .env and fill it in. `pnpm dev` gives these values to the Worker; vite.config.ts,
# cloudflare.config.ts and scripts/test-webhook.mjs read the ones marked below.
# In production, set each secret with `cf secret put <NAME>`.

# `development` puts tool arguments and comment text in the logs; anything else keeps them out (src/log.ts).
ENVIRONMENT=development

# The GitHub App Benny runs as: its id, its webhook secret and its private key (PEM, newlines written as \n).
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=

# The model provider (OpenCode Go) and the web search provider (Exa).
OPENCODE_API_KEY=
EXA_API_KEY=

# The decision model, Jev through OpenRouter (src/jev/classify.ts).
OPENROUTER_KEY=

# The cron list at /crons: the Cloudflare Access team domain and the app's audience tag. Without both it answers 401.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Not secrets. Hosts allowed to reach the dev server through a tunnel, comma-separated (vite.config.ts).
DEV_ALLOWED_HOSTS=

# Where Claude Code's containers reach this Worker's `/mcp` (cloudflare.config.ts): the deployed
# Worker's URL, and the tunnel to the dev server. Needed only in the modes that run Claude Code.
PUBLIC_BASE_URL_PRODUCTION=
PUBLIC_BASE_URL_DEV=

# For `pnpm webhook:test`: the installation the test replies through. It also uses GITHUB_WEBHOOK_SECRET above.
GITHUB_INSTALLATION_ID=
