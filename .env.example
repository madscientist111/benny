# Copy to .env. Read by vite.config.ts and scripts/test-webhook.mjs, not by the Worker.

# Hosts that may reach the dev server through a tunnel, comma-separated.
DEV_ALLOWED_HOSTS=

# For `pnpm webhook:test`: the App's webhook secret and the installation to reply through.
GITHUB_WEBHOOK_SECRET=
GITHUB_INSTALLATION_ID=
