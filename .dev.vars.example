# Copy to .dev.vars for `pnpm dev`. In production, set each value with `cf secret put <NAME>`.

# `development` puts tool arguments and comment text in the logs; anything else keeps them out (src/log.ts).
ENVIRONMENT=development

# The GitHub App Benny runs as: its id, its webhook secret and its private key (PEM, newlines written as \n).
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=

# The model provider (OpenCode Go) and the web search provider (Exa).
OPENCODE_API_KEY=
EXA_API_KEY=
