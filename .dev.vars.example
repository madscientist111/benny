# Copy to .dev.vars for `pnpm dev`. Production secrets are set with `cf secret put <NAME>`.

# Logs carry tool arguments and comment text only when this is `development` (src/log.ts).
ENVIRONMENT=development

# The GitHub App Bobby runs as: its id, webhook secret and private key (PEM, newlines as \n).
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=

# The model provider (OpenCode Go) and the web search provider (Exa).
OPENCODE_API_KEY=
EXA_API_KEY=
