  <div class="nav">
    <a class="mark" href="/">Benny <span class="mark-tag">blog</span></a>
    <ul><li><a href="/">Benny, the agent</a></li><li><a href="/software-factory">Software factory</a></li><li><a href="/blog">All posts</a></li></ul>
    <a class="gh" href={repo}><svg><use href="#i-gh"/></svg>Star on GitHub</a>
