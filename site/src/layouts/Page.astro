---
// The HTML shell every page of the site shares: head, fonts, share-card tags, and the icon sprite
// at the top of the body. Every page except the 404 also carries the same JSON-LD description of
// Benny, so search engines and answer engines name it the same way everywhere.
interface Props {
	title: string;
	description: string;
	notFound?: boolean;
}

const { title, description, notFound = false } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const shareImageUrl = new URL("/social.png", Astro.site);

const benny = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "Benny",
	alternateName: "Benny, the always-on coding agent for GitHub issues",
	description,
	url: new URL("/", Astro.site).href,
	applicationCategory: "DeveloperApplication",
	operatingSystem: "Cloudflare Workers",
	license: "https://opensource.org/licenses/MIT",
	isAccessibleForFree: true,
	offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
	sameAs: ["https://github.com/madscientist111/benny"],
	author: {
		"@type": "Person",
		"@id": "https://heyshoo.in/#person",
		name: "Devanshu Bhatt",
		url: "https://heyshoo.in",
		sameAs: ["https://github.com/madscientist111", "https://x.com/_heyshoo", "https://linkedin.com/in/devanshoo"],
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{notFound && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={pageUrl} />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={shareImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		{!notFound && <script type="application/ld+json" set:html={JSON.stringify(benny)} />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&family=Figtree:wght@400;500&family=Caveat:wght@600&display=swap"
		/>
	</head>
	<body>
		<!-- The icons every page draws with <use href="#i-...">. -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
